# PostgreSQL ulanish satri (Render/Neon/Supabase va h.k.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Server porti
PORT=4000

# JWT tokenlarni imzolash uchun maxfiy kalit — kamida 32 ta tasodifiy belgi.
# Generatsiya qilish: openssl rand -hex 32
JWT_SECRET="o'zgartiring-tasodifiy-uzun-satr-bilan"

# Admin panelda kontent o'zgargach frontend keshini bekor qilish uchun so'rov manzili.
# Production'da haqiqiy frontend domeniga o'zgartiring.
FRONTEND_REVALIDATE_URL="http://localhost:3000/api/revalidate"

# Yuqoridagi manzilga so'rov haqiqiyligini tasdiqlash uchun sir — frontend/.env
# faylidagi REVALIDATE_SECRET bilan AYNAN BIR XIL bo'lishi shart.
REVALIDATE_SECRET="o'zgartiring-boshqa-tasodifiy-satr-bilan"

# Ixtiyoriy: reverse-proxy (Render, Nginx) ortidagi "hop" chuqurligi — IP-asoslangan
# rate-limitni to'g'ri ishlashi uchun. Standart qiymat: 1.
# TRUST_PROXY_HOPS=1

# Ixtiyoriy: login urinishlari cheklovi (standart: 5 urinish / 15 daqiqa)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_WINDOW_MS=900000
